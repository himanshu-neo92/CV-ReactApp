@tailwind base;
@tailwind components;
@tailwind utilities;

/* A4 Print Styles */
@page {
  size: A4;
  margin: 8mm 0; /* 8mm top and bottom margins */
}

@page :first {
  margin: 0 0 8mm 0; /* First page: no top margin, 8mm bottom */
}

@media print {
  html, body {
    width: 210mm;
    margin: 0;
    padding: 0;
    background: white !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    .education-print {
      margin-top: 20px !important;
    }

    .cabinet-office-print {
      margin-top: 20px !important;
    }
  }

  .min-h-screen {
    min-height: auto !important;
    padding: 0 !important;
    background: white !important;
  }

  .w-\[794px\] {
    width: 210mm !important;
    max-width: 210mm !important;
    box-shadow: none !important;
    margin: 0 !important;
  }

  .bg-gradient-to-r,
  .bg-gray-50,
  .bg-gray-200,
  .bg-white {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  /* Right column: cover page 1 and 2 but not beyond */
  .right-column-print {
    margin-bottom: -8mm !important;
    padding-bottom: 8mm !important;
    max-height: 540mm !important;
    overflow: hidden !important;
  }

  /* Page break for Languages */
  .print\:break-before-page {
    page-break-before: always !important;
    break-before: page !important;
  }
}
